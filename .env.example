# ==============================================================================
# AI WORKFORCE PLATFORM — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development: cp .env.example .env
# NEVER commit production credentials or actual API keys to version control.
# ==============================================================================

# --- Core Server Runtime ---
ENVIRONMENT=development
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Relational Database (PostgreSQL 16 with RLS) ---
DATABASE_URL=postgresql+asyncpg://aiwf_user:dev_password_123@localhost:5432/aiwf_dev
DATABASE_POOL_SIZE=20

# --- Cache, Distributed Queue & Locks (Redis 7.2) ---
REDIS_URL=redis://localhost:6379/0

# --- Vector Database (Qdrant 1.9+) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Blob & Document Storage (MinIO / AWS S3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_DOCUMENTS=aiwf-dev-documents
S3_BUCKET_TRACES=aiwf-dev-traces
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_password_123
AWS_REGION=us-east-1

# --- Cryptography & Vault Envelope Encryption ---
# Generate 32-byte hex for local dev: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AWS_KMS_KEY_ID=

# --- Authentication & JWT Sessions ---
# Generate 64-byte random key: openssl rand -base64 64
JWT_SECRET_KEY=replace_with_a_secure_random_base64_string_for_jwt_signing_min_64_bytes
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# --- AI Model Gateway & Fallback Keys (Optional for Local Dev) ---
PLATFORM_OPENAI_API_KEY=
PLATFORM_ANTHROPIC_API_KEY=
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# --- Outbound Webhook Verification ---
WEBHOOK_SIGNING_SECRET=replace_with_webhook_signing_secret_min_32_chars

# --- Observability & Tracing (Langfuse & OpenTelemetry) ---
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Transactional Notifications (SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@aiworkforce.local

# --- Model Context Protocol (MCP) Sandbox ---
MCP_EXECUTION_TIMEOUT_SECONDS=30

# --- Frontend Client Configuration ---
VITE_API_BASE_URL=http://localhost:8000/v1
VITE_APP_NAME=AI Workforce
