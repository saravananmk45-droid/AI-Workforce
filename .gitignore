# ==============================================================================
# AI WORKFORCE PLATFORM — MASTER .GITIGNORE
# Strict exclusion rules for secrets, runtimes, build artifacts & dependencies
# ==============================================================================

# ── Environment & Secrets (CRITICAL) ──
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_ed25519
secrets/
credentials.json
service-account*.json

# Explicitly KEEP .env.example templates
!.env.example
!backend/.env.example
!frontend/.env.example

# ── Python Runtime & Virtual Environments ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
.env/

# ── Node.js & Frontend Tooling ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/
*.local

# ── Testing & Coverage ──
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
htmlcov/
cypress/videos/
cypress/screenshots/
.nyc_output/

# ── Database & Persistent Storage (Docker Volumes) ──
*.sqlite3
*.db
postgres_data/
redis_data/
qdrant_data/
minio_data/
data/

# ── IDE & Operating System Junk ──
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
*.log
logs/

# ── Build & Temporary Artifacts ──
tmp/
temp/
scratch/
.cache/
.parcel-cache/
.next/
out/
