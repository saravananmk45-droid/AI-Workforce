# ==============================================================================
# AI WORKFORCE PLATFORM — FRONTEND CLIENT ENVIRONMENT TEMPLATE
# Copy to frontend/.env: cp .env.example .env
# Client environment variables MUST be prefixed with VITE_ to be bundled.
# NEVER place secret API tokens or passwords here.
# ==============================================================================

# Backend API Base Gateway Endpoint
VITE_API_BASE_URL=http://localhost:8000/v1

# Application UI Title & Branding
VITE_APP_NAME=AI Workforce

# Client Analytics & Telemetry Toggle
VITE_ENABLE_ANALYTICS=false
